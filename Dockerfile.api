# SupportIQ API — FastAPI backend container
FROM python:3.11-slim

WORKDIR /app

# System deps needed by chromadb / sentence-transformers / spacy
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && python -m spacy download en_core_web_lg

COPY src/ src/
COPY data/ data/

# Build the vector store at image build time so the container is ready to
# serve immediately on start (no cold-start ingestion delay in prod).
RUN python -m src.ingest

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "8000"]
