# SupportIQ UI — Streamlit frontend container
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# en_core_web_lg (needed by Presidio for PII detection) is installed as part
# of requirements.txt above via a direct wheel URL — no separate
# `spacy download` step needed.

COPY src/ src/
COPY data/ data/
COPY app.py .

# Vector store is built at image build time, same as the API image.
# In docker-compose, both services instead share one pre-built volume
# (see docker-compose.yml) so ingestion only happens once.
RUN python -m src.ingest

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501"]